# Azure OpenAI 接続設定
# ローカル開発用: このファイルを .env にコピーして値を記入する（.env は gitignore / dockerignore 対象）
# 本番（Cloud Run）では .env を使わず、Secret Manager → --update-secrets で同名の環境変数として渡す（README 参照）
# 未設定の場合、AI パラメータ補完はモック（デモ）モードで動作する
# AI エージェント（AI_agent/）も同じ設定を使用する（未設定時は利用不可。function calling 対応モデルを指定）
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
